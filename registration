    <script>
        let currentStep = 1;
        const progress = document.querySelector('.progress');
        
        function updateProgress() {
            const width = ((currentStep - 1) / 6) * 100 + '%';
            progress.style.setProperty('--progress-width', width);
            progress.style.animation = 'none';
            setTimeout(() => progress.style.animation = 'progressAnim 0.5s forwards', 10);
        }
        
        function nextStep(step) {
            document.getElementById(`step${currentStep}`).classList.remove('active');
            document.getElementById(`step${currentStep}`).classList.add('slide-left');
            currentStep = step;
            document.getElementById(`step${currentStep}`).classList.add('active', 'slide-right');
            updateProgress();
        }
        
        function prevStep(step) {
            document.getElementById(`step${currentStep}`).classList.remove('active');
            document.getElementById(`step${currentStep}`).classList.add('slide-right');
            currentStep = step;
            document.getElementById(`step${currentStep}`).classList.add('active', 'slide-left');
            updateProgress();
        }
        
        // Staggered Reveal for Form Elements
        document.querySelectorAll('.step label').forEach((el, idx) => {
            el.style.animation = `fadeInUp 0.5s ease-out ${idx * 0.1}s forwards`;
            el.style.opacity = 0;
        });
        
        // Hide loader after load
        window.addEventListener('load', () => document.querySelector('.loader').style.display = 'none');
    </script>
    
