# Block execution of scripts in this uploads folder — images/PDFs are unaffected.
<FilesMatch "\.(php|php\d?|phtml|pl|py|cgi|asp|aspx|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI -Indexes